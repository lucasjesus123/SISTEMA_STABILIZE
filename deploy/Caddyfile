# =====================================================================
# Proxy de borda.
#
# O Caddy foi escolhido no lugar do nginx por uma razão específica: TLS
# automático, com renovação, sem cron e sem certbot. A causa mais comum
# de sistema pequeno cair não é ataque — é certificado vencido.
# =====================================================================
{
	# E-mail da conta do Let's Encrypt (avisos de expiração).
	#
	# O valor padrão existe só para o MODO INTERNO, onde não há emissão
	# de certificado nenhuma — sem ele, uma variável vazia quebraria o
	# parse do Caddyfile com um erro que não diz nada sobre o motivo.
	# Ele não vira armadilha silenciosa no modo borda: o Let's Encrypt
	# recusa contato em domínio .invalid, então a emissão falha alto e
	# claro em vez de passar despercebida.
	email {$EMAIL_TLS:sem-acme-no-modo-interno@exemplo.invalid}
	# Servidor não anuncia o que é. Não impede ataque nenhum, mas tira
	# o sistema das buscas por versão vulnerável.
	servers {
		trusted_proxies static private_ranges
	}
}

# O endereço vem do ambiente porque decide o MODO de operação:
#
#   sistema.dominio.com.br  → Caddy na borda, emite TLS sozinho
#   :80                     → atrás de outro proxy; HTTP puro, sem ACME
#
# Escrever o domínio fixo aqui obrigaria toda VPS que já tem proxy a
# editar este arquivo — e um Caddy tentando emitir certificado sem a
# porta 80 pública entra em laço de falha do ACME.
{$ENDERECO_CADDY} {
	encode zstd gzip

	header {
		# HSTS com preload: depois disto o navegador RECUSA http para
		# este domínio, mesmo que alguém digite. Um ano.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# O sistema não usa câmera, microfone nem geolocalização. Negar
		# de antemão fecha o que uma dependência comprometida tentaria.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server

		# CONTENT-SECURITY-POLICY.
		#
		# Ela só é escrevível assim porque o sistema não busca NADA de
		# terceiro: as fontes passaram a ser servidas por nós, e não há
		# CDN, tag de analytics nem widget. `default-src 'self'` é o
		# começo e o fim da história.
		#
		# `style-src` precisa de 'unsafe-inline' e não é descuido: são
		# doze atributos `style` que carregam VALOR CALCULADO — a
		# porcentagem do anel de constância, a largura da barra de
		# progresso da série. Isso não cabe em folha de estilo. O risco
		# que 'unsafe-inline' abre em `style-src` é de exfiltração por
		# seletor, não execução de código; `script-src` continua
		# fechado, que é o que impede XSS de virar execução.
		#
		# `frame-ancestors 'none'` é o X-Frame-Options em versão que os
		# navegadores atuais realmente consultam.
		#
		# `img-src` PRECISA DE `blob:`, e a falta dele derrubou TODA foto
		# do sistema em produção — e só em produção.
		#
		# A causa está no desenho do acesso: o token de acesso vive em
		# MEMÓRIA, e o carregador de imagem do navegador não manda
		# cabeçalho nenhum. Um `<img src="/api/perfil/foto">` chegaria
		# sem autenticação e voltaria 401. Por isso toda foto é buscada
		# por `fetch` — que manda o Authorization — e exibida como
		# `URL.createObjectURL(blob)`. Ou seja: no Stabilize, foto de
		# perfil, foto de aluno, foto de exercício e logo da academia são
		# TODAS `blob:`.
		#
		# Por que só quebrava em produção: o servidor de desenvolvimento
		# não aplica esta CSP. Local funcionava, no ar não — e a
		# mensagem que sobrava para quem usava era "Não consegui abrir a
		# imagem. Envie outra", que manda trocar de arquivo quando o
		# arquivo nunca foi o problema.
		#
		# Medido, servindo a mesma página sob as duas CSPs:
		#   img-src 'self' data:        -> "Refused to load the image
		#                                   'blob:...' because it
		#                                   violates ... CSP"
		#   img-src 'self' data: blob:  -> a imagem carrega, 600x600
		#
		# `blob:` NÃO afrouxa o que interessa: é a própria página que
		# cria o blob, a partir de bytes que ela já buscou de `'self'`.
		# Não abre origem externa nenhuma, e `script-src` continua
		# fechado — que é o que impede XSS de virar execução.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	# --- API ---
	handle /api/* {
		reverse_proxy api:3333 {
			header_up X-Real-IP {remote_host}
			# `caddy validate` avisa que estas duas linhas são
			# desnecessárias, porque o Caddy já repassa os cabeçalhos.
			# NÃO SÃO, e a diferença importa: o comportamento padrão
			# ACRESCENTA o IP real ao que veio do cliente, então quem
			# mandasse `X-Forwarded-For: 9.9.9.9` produziria a cadeia
			# "9.9.9.9, <ip real>". Aqui a linha SOBRESCREVE: o que o
			# cliente inventou é descartado na borda.
			#
			# A API não depende disto (usa `trustProxy: 1`, que lê a
			# ponta direita da cadeia), mas as duas defesas juntas
			# significam que nenhuma das duas sozinha é ponto único de
			# falha para o rate limit do login e para a auditoria.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /health {
		reverse_proxy api:3333
	}

	# --- front ---
	handle {
		root * /srv

		# Os arquivos com hash no nome são imutáveis: cache longo.
		@comHash path_regexp \-[A-Za-z0-9_-]{8,}\.(js|css|woff2)$
		header @comHash Cache-Control "public, max-age=31536000, immutable"

		# As fontes não têm hash no nome (Outfit-latin.woff2), então não
		# entram na regra acima. Uma semana: elas praticamente não mudam,
		# mas trocar a tipografia da marca não pode significar um ano de
		# gente vendo a antiga.
		header /fontes/* Cache-Control "public, max-age=604800"

		# NENHUM DESTES TRÊS PODE FICAR PRESO EM CACHE.
		#
		# O index aponta para os arquivos novos depois de um deploy; em
		# cache, o usuário fica na versão anterior.
		#
		# O sw.js é pior: ele é o que decide o que TODO o resto serve.
		# Um service worker velho preso no cache continua entregando a
		# versão antiga do aplicativo mesmo depois do deploy, e o
		# usuário não tem como sair disso — não há botão de "atualizar"
		# num aplicativo em tela cheia. Os navegadores atuais já
		# revalidam o script do worker por conta própria, mas isso é
		# comportamento deles, não garantia nossa.
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest Cache-Control "no-cache"

		# SPA: qualquer rota desconhecida devolve o index.
		try_files {path} /index.html
		file_server
	}
}
