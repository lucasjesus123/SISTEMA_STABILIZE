# =====================================================================
# Stabilize — modelo de configuração
#
# Copie para .env e preencha. O .env real NUNCA vai para o repositório
# (já está no .gitignore).
#
# Nenhuma variável abaixo tem valor padrão no código: a API recusa subir
# com configuração incompleta ou fraca. Isso é intencional — a
# alternativa é descobrir em produção que o segredo era "changeme".
# =====================================================================

NODE_ENV=development
PORT=3333
# Em produção, atrás de proxy reverso, mantenha em 127.0.0.1 para que a
# API não fique exposta diretamente na internet.
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Banco de dados
#
# Duas credenciais DIFERENTES, de propósito:
#
#   DATABASE_URL            runtime da API. Papel stabilize_app:
#                           sem BYPASSRLS, sem superusuário, sem DDL.
#   DATABASE_MIGRATION_URL  só para migrations. Papel stabilize_migrator.
#
# Se a API for comprometida, a credencial dela não permite derrubar
# tabela, desligar Row-Level Security nem ler dados de outra empresa.
# Usar a mesma credencial para as duas coisas anula essa proteção.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://stabilize_app:TROQUE@127.0.0.1:5432/stabilize
DATABASE_MIGRATION_URL=postgresql://stabilize_migrator:TROQUE@127.0.0.1:5432/stabilize

DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Usado pelo docker-compose para criar o banco local de desenvolvimento.
POSTGRES_DB=stabilize
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# Segredos de sessão
#
# Gere cada um separadamente:
#   openssl rand -base64 48
#
# Access e refresh usam segredos DISTINTOS: se um vazar, o outro não
# permite forjar o par. A API recusa subir em produção se forem iguais.
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Cifra os tokens de terceiros guardados no banco (uazapi).
# Exatamente 32 bytes em base64:  openssl rand -base64 32
ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# CORS — lista explícita, separada por vírgula. Curinga "*" é recusado
# em produção, assim como origem sem HTTPS.
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Anexos (exames, laudos, fotos) — dado de saúde.
# Aponte para um diretório FORA da raiz servida pelo servidor web:
# dentro dela, qualquer pessoa com a URL baixa o exame de qualquer aluno.
# ---------------------------------------------------------------------
STORAGE_DIR=./storage
UPLOAD_MAX_BYTES=20971520

# ---------------------------------------------------------------------
# Limites de requisição e bloqueio de força bruta
# ---------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=300
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------
# WhatsApp (uazapi) — opcional; o sistema opera sem isso configurado.
# O token de ADMIN cria instâncias e é o mais sensível do arquivo.
# ---------------------------------------------------------------------
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=
